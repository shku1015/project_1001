# 로컬 개발용 환경 변수 목록. 이 파일을 .env로 복사해 값을 채운다.
# .env는 커밋하지 않는다 (공개 저장소).

# PostgreSQL (docker-compose.yml, 서버 앱 공통)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=admin
DB_USERNAME=admin
DB_PASSWORD=

# 인증
# Access Token 서명 키 (32바이트 이상). 예: openssl rand -base64 48
JWT_SECRET=
# 최초 관리자(admin) 비밀번호. 비어 있으면 만들지 않는다. 첫 로그인 때 바꿔야 한다
INITIAL_ADMIN_PASSWORD=
# 로컬은 HTTP라 쿠키 Secure를 끈다. 운영(HTTPS)에서는 지우거나 true
COOKIE_SECURE=false

# 테스트 관리자(t_super 등) 비밀번호. local 프로필의 테스트 데이터에서만 쓴다.
TEST_ADMIN_PASSWORD=

# 첨부파일 저장 경로
FILE_BASE_PATH=./data/files
